{
  "name": "andy87/knock-knock",
  "description": "Small, immutable, dependency-free PHP cURL HTTP client facade.",
  "keywords": ["php", "curl", "http", "client", "facade", "knock-knock"],
  "license": "CC-BY-SA-4.0",
  "require": {
    "php": ">=8.2",
    "ext-curl": "*",
    "ext-json": "*"
  },
  "autoload": {
    "psr-4": { "KnockKnock\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "KnockKnock\\Tests\\": "tests/" }
  },
  "scripts": {
    "test": "php tests/run.php"
  },
  "config": { "sort-packages": true }
}
